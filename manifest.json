{
  "name": "TrackHero",
  "version": "1.0.0",
  "description": "Track your progress with ease and get certified.",
  "permissions": ["activeTab", "storage", "tabs", "scripting", "webNavigation"],
  "host_permissions": ["https://*.youtube.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "certificate-template.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://*.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_title": "TrackHero",
    "default_popup": "popup.html"
  },
  "manifest_version": 3
}
